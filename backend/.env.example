# Perfil local. Copia este archivo a .env y configura secretos propios.
DATABASE_URL=postgresql+psycopg://gv_app@127.0.0.1:55432/glucovida_local
GLUCOVIDA_ENVIRONMENT=development
GLUCOVIDA_ALLOWED_ORIGINS=["https://app.glucovida.local"]
GLUCOVIDA_CSRF_KEY=
GLUCOVIDA_RATE_LIMIT_KEY=
GLUCOVIDA_REDIS_URL=redis://127.0.0.1:16379/14
GLUCOVIDA_SMTP_HOST=127.0.0.1
GLUCOVIDA_SMTP_PORT=1465
GLUCOVIDA_SMTP_STARTTLS=false
GLUCOVIDA_SMTP_SENDER=no-reply@example.com
GLUCOVIDA_SMTP_CA_FILE=
GLUCOVIDA_VERIFICATION_PAGE=https://app.glucovida.local/verify
GLUCOVIDA_TERMS_VERSION=terms-v1.0.0
GLUCOVIDA_PRIVACY_VERSION=privacy-v1.0.0
GLUCOVIDA_HEALTH_DATA_VERSION=health-data-v1.0.0
GLUCOVIDA_VERIFICATION_TTL_MINUTES=30
GLUCOVIDA_REGISTRATION_IP_REQUESTS=5
GLUCOVIDA_REGISTRATION_IP_WINDOW_SECONDS=60
GLUCOVIDA_REGISTRATION_EMAIL_REQUESTS=2
GLUCOVIDA_REGISTRATION_EMAIL_WINDOW_SECONDS=900

# Perfil futuro de destino. Inyecta estas variables mediante el despliegue.
# GLUCOVIDA_ENVIRONMENT=production
# GLUCOVIDA_PUBLIC_REGISTRATION_ENABLED=false
# GLUCOVIDA_PRODUCTION_RELEASE_APPROVED=false
